# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=retarget
POSTGRES_PASSWORD=retarget_dev
POSTGRES_DB=retarget_agent
DATABASE_URL=postgresql+asyncpg://retarget:retarget_dev@localhost:5432/retarget_agent

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=retarget
CLICKHOUSE_PASSWORD=retarget_dev
CLICKHOUSE_DB=retarget_events

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# External APIs
PEOPLE_DATA_LABS_API_KEY=
FULLCONTACT_API_KEY=
PROXYCURL_API_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=

# App Settings
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
# Production: API_BASE_URL=https://api.getbeam.fyi
API_BASE_URL=http://localhost:8000
# Production: FRONTEND_URL=https://getbeam.fyi
FRONTEND_URL=http://localhost:3000
# Production: PIXEL_BASE_URL=https://pixel.getbeam.fyi
PIXEL_BASE_URL=http://localhost:8787

# Clerk Auth
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# OAuth: Social Platform Credentials (EasyEngage)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/twitter
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/facebook
# Instagram can use its OWN Meta app (Meta forbids the Instagram use case and the
# consumer "Facebook Login" use case in the same app). Leave INSTAGRAM_APP_ID/SECRET
# empty to reuse FACEBOOK_APP_ID/SECRET (legacy single-app setups). Instagram needs an
# IG Business/Creator account linked to a Facebook Page.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/instagram
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/linkedin
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/tiktok

# LinkedIn outreach sidecar (phantommm) — sends REAL LinkedIn connection
# requests. Beam never talks to LinkedIn directly and never stores the raw
# LinkedIn cookie (it lives encrypted inside phantommm). Both must be set or the
# LinkedIn-outreach endpoints return HTTP 503 "LinkedIn outreach not configured".
# PHANTOMMM_API_KEY must MATCH phantommm's own API_KEY — it is sent as the
# `x-api-key` header on every call, and phantommm must be reachable at BASE_URL.
PHANTOMMM_BASE_URL=
PHANTOMMM_API_KEY=

# Token encryption for OAuth tokens at rest (generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=

# Feed sync interval (minutes)
SYNC_INTERVAL_MINUTES=15

# Rate Limits
DEFAULT_DAILY_RESOLUTION_BUDGET=50
MAX_EMAILS_PER_HOUR_PER_SITE=50
