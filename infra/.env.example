# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=retarget
POSTGRES_PASSWORD=retarget_dev
POSTGRES_DB=retarget_agent
DATABASE_URL=postgresql+asyncpg://retarget:retarget_dev@localhost:5432/retarget_agent

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=retarget
CLICKHOUSE_PASSWORD=retarget_dev
CLICKHOUSE_DB=retarget_events

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# External APIs
PEOPLE_DATA_LABS_API_KEY=
FULLCONTACT_API_KEY=
PROXYCURL_API_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=

# Twitter/X API
TWITTER_BEARER_TOKEN=

# App Settings
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
PIXEL_BASE_URL=http://localhost:8787

# Mock mode (set to true for development without real API calls)
MOCK_EXTERNAL_APIS=true

# Rate Limits
DEFAULT_DAILY_RESOLUTION_BUDGET=50
MAX_EMAILS_PER_HOUR_PER_SITE=50
