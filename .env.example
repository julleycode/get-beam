# Beam — local API / root env template
# Copy to repo-root `.env` (never commit `.env`):
#   Windows:  Copy-Item .env.example .env
#   macOS:    cp .env.example .env
#
# Loaded by apps/api/config.py (pydantic-settings) from ../../.env

# ─── Core (required for local) ───────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
API_BASE_URL=http://localhost:8000
# To test a pixel on another public website, use the LOCKED-DOWN tunnel hostname
# here (this machine: https://beam-dev.nhantown.com — 3 paths, everything else
# 404s). To publish the dashboard too, also set FRONTEND_URL below to
# https://beam.nhantown.com and web NEXT_PUBLIC_API_URL to
# https://beam-api.nhantown.com. See docs/deployment-guide.md.
FRONTEND_URL=http://localhost:3000
PIXEL_BASE_URL=http://localhost:8000

# Host port 5433 → container 5432 (see infra/docker-compose.yml). Use 5432 only if nothing else owns it.
DATABASE_URL=postgresql+asyncpg://retarget:retarget_dev@localhost:5433/retarget_agent
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ClickHouse — optional / unused by live API
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=retarget
CLICKHOUSE_PASSWORD=retarget_dev
CLICKHOUSE_DB=retarget_events

# ─── Auth (local can leave Clerk empty → JWT /login at :3000/login) ─
# Demo: demo@getbeam.fyi / password123 (scripts/ensure_demo_user.py)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ─── AI (optional locally; leave empty to skip live Gemini calls) ─
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=   # legacy — not primary
MOCK_EXTERNAL_APIS=false

# ─── Email / billing (optional locally) ─────────────────
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_SECRET=
GUMROAD_WEBHOOK_SECRET=
GUMROAD_PRODUCT_PERMALINK=
# RESEND_API_KEY=      # deprecated

# ─── Identity providers (optional; empty = skip paid lookups) ─
PEOPLE_DATA_LABS_API_KEY=
PROXYCURL_API_KEY=
FULLCONTACT_API_KEY=
# Shared token in the Leadpipe dashboard's webhook URL:
#   https://<host>/webhooks/identity/leadpipe?token=<this value>
# Empty = the endpoint is disabled (403), never open.
LEADPIPE_WEBHOOK_SECRET=
# Poll GET /v1/data inside the resolution waterfall. Leave true until the
# webhook above has proven itself — both paths may run at once without
# creating duplicate identities.
LEADPIPE_PULL_ENABLED=true

# ─── Encryption (optional in APP_ENV=development; REQUIRED if APP_ENV=production) ─
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY=

# ─── AI-agent detection (all default false; turn on together to test the flow) ─
# Apply migrations BEFORE flipping any of these on — the code reads columns that
# only exist after `alembic upgrade head`.
#
# Off, a recognised AI agent is dropped silently and nothing is recorded at all.
AGENT_DETECTION_ENABLED=false
# Off, the public agent surface (manifest.json / offers.json / llms.txt / MCP)
# answers 404 and is not revealed to exist.
AGENT_GATEWAY_ENABLED=false
# Stamps each same-host offer URL with a per-fetch marker, so the human who
# clicks it is matched to the exact agent fetch instead of guessed at by the
# 30-minute temporal sweep. Needs ENCRYPTION_KEY above: without one the feed
# still serves, it just carries no marker.
# NOTE: turning this on also switches offers.json to no-store. A marker is
# per-fetch, so a shared cache would hand the first agent's marker to every
# agent behind it and attribute the human to the wrong fetch.
AGENT_MARKER_ENABLED=false

# ─── OAuth redirects default to localhost (fill client ids when testing connectors) ─
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/twitter
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/facebook
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/linkedin

# LinkedIn outreach sidecar (optional)
PHANTOMMM_BASE_URL=
PHANTOMMM_API_KEY=

SYNC_INTERVAL_MINUTES=15
DEFAULT_DAILY_RESOLUTION_BUDGET=50
# Days before retrying a failed identity resolution. 0 = gate off (retries allowed).
# Set 30 to restore the historical no-retry lock. Daily budget/plan cap still apply.
RESOLUTION_RETRY_COOLDOWN_DAYS=0
MAX_EMAILS_PER_HOUR_PER_SITE=50

# ─── Onboarding canary / farbled / re-engagement (Julley 11-08) ───
# Apply migrations before flipping: alembic -c apps/api/alembic.ini upgrade head
# Playwright canary/farbled e2e mostly mocks the network; LOCATION_REVEAL is for
# live API canary smoke. Keep farbled + reengagement OFF unless testing those paths.
LOCATION_REVEAL_ENABLED=false
BEAM_SELF_SITE_ID=site_90a488f43eac
MAXMIND_LICENSE_KEY=
MAXMIND_CITY_DB_PATH=
MAXMIND_ASN_DB_PATH=
REENGAGEMENT_ENABLED=false
REENGAGEMENT_SWEEP_HOUR_UTC=14
REENGAGEMENT_REMIND_AFTER_DAYS=7
REENGAGEMENT_PAUSE_AFTER_DAYS=14
REENGAGEMENT_PAUSE_WARNING_MIN_DAYS=3
REENGAGEMENT_INSTALL_NUDGE_ENABLED=false
REENGAGEMENT_INSTALL_NUDGE_AFTER_DAYS=3
FARBLLED_GRAPH_WRITE_GUARD_ENABLED=false
FARBLLED_FINGERPRINT_GATE_ENABLED=false
FINGERPRINT_V2_FALLBACK_ENABLED=false
# E2E_PRIVACY_HOLD_VISITOR=
