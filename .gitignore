# Environment
.env
.env.local
.env.*.local

# Graphify knowledge graph (generated)
**/graphify-out/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/

# Node
node_modules/
.next/
.turbo/
out/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Redis dump (local dev)
dump.rdb

# GeoIP
*.mmdb

# Test
.coverage
htmlcov/
.pytest_cache/

# beam landing: keep the 53MB source video out of git (compressed launch.mp4 is committed)
apps/web/public/beam/launch.src.mp4

.ruff_cache/
.claude/worktrees/
.env.*
**/.env
# Templates must stay trackable (negate after `.env.*` above)
!.env.example
!**/.env.example
!infra/.env.example
.vibecode-backup*/
.claude/hooks/.logs/

# Local helper runtime files
.dev-local.pids
.dev-local-*.log
apps/web/.env.local

# Published agent IP ranges refetched at runtime. The shipped *.json files stay
# tracked and empty; the refresh job writes only here so it never dirties git.
apps/api/data/agent_ip_ranges/runtime/

# Wrangler local cache (account id, pages metadata) — never commit
**/.wrangler/
