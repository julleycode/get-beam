# Beam web (Next.js) — local env template
# Copy to apps/web/.env.local (Next loads this automatically; never commit):
#   Windows:  Copy-Item apps\web\.env.example apps\web\.env.local
#   macOS:    cp apps/web/.env.example apps/web/.env.local
#
# NEXT_PUBLIC_* is baked into the browser bundle at build/dev start.
# Server-only vars (no NEXT_PUBLIC_) stay on the Next server (middleware/beacon).

# ─── Required for local dashboard talking to local API ───
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Clerk (optional) ────────────────────────────────────
# Leave EMPTY for local JWT auth at http://localhost:3000/login
# (demo user: demo@getbeam.fyi / password123 — created by scripts/ensure_demo_user.py).
# If set, ClerkProvider activates and /sign-in|/sign-up are used instead.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── EvalLayer fetch-beacon (optional locally) ───────────
# Must match API BEAM_FETCH_BEACON_SECRET / related config if you test agent fetch.
BEAM_FETCH_BEACON_SECRET=
BEAM_API_BASE=http://localhost:8000
BEAM_SITE_ID=
