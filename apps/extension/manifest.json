{
  "manifest_version": 3,
  "name": "Beam — LinkedIn Outreach Connect",
  "version": "1.0.0",
  "description": "One-click connect your LinkedIn session to your Beam dashboard — no manual DevTools cookie copying.",
  "key": "",
  "permissions": ["cookies"],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "https://getbeam.fyi/*",
    "http://localhost:3000/*"
  ],
  "externally_connectable": {
    "matches": ["https://getbeam.fyi/*", "http://localhost:3000/*"]
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://getbeam.fyi/*", "http://localhost:3000/*"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "Beam LinkedIn Connect",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
